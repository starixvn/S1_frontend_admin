pipeline {
    agent any
    environment {
        env = 'dev'
        registry = '13.213.82.69' 
        proj = 'frontend/adminweb'
        ansible_path = '/var/jenkins_home/ansible/frontend'
        harborAccount = 'jenkins'
        harborPassword = '06ftJ0Ds'
        dockerHost= 'linux-dev'
        dockerPorts = '5071:5071,443:443'
        dockerName = 'dev_adminweb'
        nginxVolume= '/nginx/admin:/etc/nginx/conf.d'
    }
    stages {
        stage('Build') {
            agent { node { label 'Build' } }
            steps {
                script {
                    env.version = sh (script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                }
                sh 'sudo docker build -t ${registry}/${proj}:${version} .'
                sh 'sudo docker login ${registry} -u ${harborAccount} -p ${harborPassword}'
                sh 'sudo docker push ${registry}/${proj}:${version}'
                sh 'sudo docker rmi ${registry}/${proj}:${version}'
            }
        }
        stage('Deploy') {
            agent { node { label 'master' } }
            steps {
                sh 'ansible-playbook -i ${ansible_path}/DEV.AWS.yml ${ansible_path}/deploy.docker.yml --extra-vars "host=${dockerHost} docker_name=${dockerName} ver=${proj}:${version} env=${env} docker_ports=${dockerPorts} volume=${nginxVolume}"'
            }
        }
    }
}


