pipeline {
    agent none
    environment {
        env = 'Development'
        registry = '13.213.82.69/desktop/admin-dev'
        ansible_path = '/var/jenkins_home/ansible/frontend'
    }
    stages {
        stage('Build') {
            agent { node { label 'Build' } }
            steps {
                script {
                    env.version = sh (script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                }
                sh 'sudo docker build -t ${registry}:${version} .'
                sh 'sudo docker login 13.213.82.69 -u jenkins -p 06ftJ0Ds'
                sh 'sudo docker push ${registry}:${version}'
                sh 'sudo docker rmi ${registry}:${version}'
            }
        }
        stage('Deploy') {
            agent { node { label 'master' } }
            steps {
                sh 'ansible-playbook -i ${ansible_path}/DEV.AWS.yml ${ansible_path}/deploy.docker.yml --extra-vars "host=linux-dev docker_name=dev_adminweb ver=desktop/admin-dev:${version} env=${env} docker_ports=5071:5071,443:443 volume=/nginx/admin:/etc/nginx/conf.d"'
            }
        }
        stage('ArgoCD'){
            agent { node { label 'Build' } }
                steps{
                    dir('/jenkins/Manifest/galaxy/leobet'){
                        sh 'git pull'
                        sh "yq -i '.spec.template.spec.containers[0].image = \"harbor.ailabpte.co/desktop/admin-dev:${version}\"' adminweb-deploy.yaml"
                        sh 'git add adminweb-deploy.yaml'
                        sh "git commit -m 'update admin ver:${version}'"
                        sh 'git push'
                    }
                }
            }
    }
}